# Copy to .env.local. Everything here is optional.

# --- Inference seam -------------------------------------------------------
# Unset (the default): /api/generate serves the built-in mock engine.
# Set: /api/generate proxies to the Python inference service (Track B).
# INFERENCE_API_URL=https://your-inference-service.example.com
# Optional bearer token sent to the inference service. Server-side only.
# INFERENCE_API_TOKEN=

# --- Mock engine (ignored when INFERENCE_API_URL is set) ------------------
# Probability [0-1] a request hits a simulated cold start (503). Default 0.05.
# MOCK_COLD_START_RATE=0.05
# Probability [0-1] a request fails mid-denoise. Default 0.02.
# MOCK_ERROR_RATE=0.02
# Step latency multiplier; 1 approximates SDXL on a warm A10G. Default 1.
# MOCK_SPEED=1
